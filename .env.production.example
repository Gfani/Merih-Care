# ==========================================
# Merih Care - Production Environment Template
# Copy this file to .env.production on the server and populate secrets
# ==========================================

# Application Port and Prefix
PORT=3000
NODE_ENV=production
API_PREFIX=api/v1
AUTO_SEED=false

# Database Configuration (PostgreSQL)
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=merihcare_user
DB_PASSWORD=<CHANGE_ME_STRONG_DATABASE_PASSWORD>
DB_DATABASE=merihcare_db
DB_SSL=false

# Cache Configuration (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<CHANGE_ME_STRONG_REDIS_PASSWORD>
REDIS_URL=redis://:<CHANGE_ME_STRONG_REDIS_PASSWORD>@redis:6379
REDIS_REQUIRED=true

# JWT Security
JWT_SECRET=<CHANGE_ME_RANDOM_64_CHAR_JWT_SECRET>
JWT_EXPIRATION_TIME=1d

# Uploads & Object Storage
UPLOADS_DIR=/app/uploads
STORAGE_ENDPOINT=https://api.merihcare.et
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio_root_user
S3_SECRET_KEY=<CHANGE_ME_MINIO_SECRET_KEY>
S3_BUCKET_NAME=merihcare-medical-records
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Payment Gateway (Chapa Production Credentials)
CHAPA_SECRET_KEY=<CHANGE_ME_REAL_CHAPA_LIVE_SECRET_KEY>
CHAPA_PUBLIC_KEY=<CHANGE_ME_REAL_CHAPA_LIVE_PUBLIC_KEY>
CHAPA_WEBHOOK_SECRET=<CHANGE_ME_CHAPA_WEBHOOK_SECRET>
CHAPA_BASE_URL=https://api.chapa.co/v1

# Outbound Notification Providers
SENDGRID_API_KEY=<CHANGE_ME_SENDGRID_API_KEY>
MAIL_FROM=no-reply@merihcare.et
AFRICASTALKING_API_KEY=<CHANGE_ME_AFRICASTALKING_API_KEY>
AFRICASTALKING_USERNAME=<CHANGE_ME_AFRICASTALKING_USERNAME>
FCM_SERVER_KEY=<CHANGE_ME_FCM_SERVER_KEY>

# Error Tracking & Metrics
SENTRY_DSN=
PROMETHEUS_PORT=9090
