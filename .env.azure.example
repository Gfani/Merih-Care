# ==============================================================================
# Merihcare - Microsoft Azure Production Environment Template
# ==============================================================================

# Core Application Settings
PORT=3000
NODE_ENV=production
API_PREFIX=api/v1
AUTO_SEED=false

# Azure Database for PostgreSQL Flexible Server
DB_TYPE=postgres
DB_HOST=<psql-server-name>.postgres.database.azure.com
DB_PORT=5432
DB_USERNAME=merihcare_admin
DB_PASSWORD=<CHANGE_ME_STRONG_DATABASE_PASSWORD>
DB_DATABASE=merihcare_db
DB_SSL=true

# Azure Cache for Redis (or Containerized Redis)
REDIS_HOST=<redis-cache-name>.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=<CHANGE_ME_REDIS_ACCESS_KEY>
REDIS_URL=rediss://:<CHANGE_ME_REDIS_ACCESS_KEY>@<redis-cache-name>.redis.cache.windows.net:6380
REDIS_REQUIRED=true

# JWT Authentication & Encryption
JWT_SECRET=<CHANGE_ME_RANDOM_64_CHAR_HEX_SECRET>
JWT_EXPIRATION_TIME=1d
ENCRYPTION_KEY=<CHANGE_ME_SECURE_256BIT_HEX_KEY>

# Azure Files / Storage Mount for Credentials & Clinical Documents
UPLOADS_DIR=/app/uploads
STORAGE_ENDPOINT=https://<your-backend-app>.azurecontainerapps.io/api/v1/uploads/view

# CORS Policy (Allow Azure Static Web Apps, Custom Domains, and Mobile App)
CORS_ORIGIN=https://<your-admin-app>.azurestaticapps.net,https://admin.merihcare.et,https://merihcare.et

# Chapa Payment Gateway (Production Credentials)
CHAPA_SECRET_KEY=<CHANGE_ME_REAL_CHAPA_LIVE_SECRET_KEY>
CHAPA_PUBLIC_KEY=<CHANGE_ME_REAL_CHAPA_LIVE_PUBLIC_KEY>
CHAPA_WEBHOOK_SECRET=<CHANGE_ME_CHAPA_WEBHOOK_SECRET>
CHAPA_BASE_URL=https://api.chapa.co/v1

# Outbound Communications
SENDGRID_API_KEY=<CHANGE_ME_SENDGRID_API_KEY>
MAIL_FROM=no-reply@merihcare.et
AFRICASTALKING_API_KEY=<CHANGE_ME_AFRICASTALKING_API_KEY>
AFRICASTALKING_USERNAME=<CHANGE_ME_AFRICASTALKING_USERNAME>
FCM_SERVER_KEY=<CHANGE_ME_FCM_SERVER_KEY>
