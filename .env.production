# Application Port and Prefix
PORT=3000
NODE_ENV=production
API_PREFIX=api/v1

# Database Configuration
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=merihcare_user
DB_PASSWORD=merihcare_secure_prod_password
DB_DATABASE=merihcare_db
DB_SSL=false

# Cache Configuration (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=merihcare_redis_secure_password

# JWT Security
JWT_SECRET=merihcare_jwt_production_signing_key_secret_123!
JWT_EXPIRATION_TIME=1d

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio_root_user
S3_SECRET_KEY=minio_root_secure_password
S3_BUCKET_NAME=merihcare-medical-records
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Error Tracking and Monitoring (Sentry/GlitchTip Mock keys)
SENTRY_DSN=https://sentry_mock_key@error-tracking.merihcare.et/1
PROMETHEUS_PORT=9090
