PORT=3000
NODE_ENV=staging
API_PREFIX=api/v1

# Database Configuration (PostgreSQL / SQLite)
DB_TYPE=postgres
DB_HOST=staging-db.merihcare.et
DB_PORT=5432
DB_USERNAME=merihcare_staging_user
DB_PASSWORD=merihcare_staging_password
DB_DATABASE=merihcare_staging_db
DB_SSL=true

# Cache Configuration (Redis)
REDIS_HOST=staging-redis.merihcare.et
REDIS_PORT=6379

# JWT / Security
JWT_SECRET=staging_secret_jwt_key_change_me_in_production
JWT_EXPIRATION_TIME=1d

# Automatic seeding on bootstrap
AUTO_SEED=false
