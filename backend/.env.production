PORT=3000
NODE_ENV=production
API_PREFIX=api/v1

# Database Configuration (PostgreSQL / SQLite)
DB_TYPE=postgres
DB_HOST=prod-db.merihcare.et
DB_PORT=5432
DB_USERNAME=merihcare_prod_user
DB_PASSWORD=merihcare_prod_password_must_be_strong
DB_DATABASE=merihcare_prod_db
DB_SSL=true

# Cache Configuration (Redis)
REDIS_HOST=prod-redis.merihcare.et
REDIS_PORT=6379

# JWT / Security
JWT_SECRET=production_secret_jwt_key_must_be_strong_and_unique_per_install
JWT_EXPIRATION_TIME=1d

# Automatic seeding on bootstrap
AUTO_SEED=false

# Outbound Email (Resend)
RESEND_FROM_EMAIL=Merihcare <otp@merihcare.live>
MAIL_FROM=otp@merihcare.live
