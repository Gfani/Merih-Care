            "type": "string",
            "description": "Rejection reason"
          }
        },
        "required": [
          "reason"
        ]
      },
      "RequestCorrectionsDto": {
        "type": "object",
        "properties": {
          "comments": {
            "type": "string",
            "description": "Correction request comments/instructions"
          }
        },
        "required": [
          "comments"
        ]
      },
      "CreateAppointmentDto": {
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string",
            "description": "Patient ID"
          },
          "patientName": {
            "type": "string",
            "description": "Patient Display Name"
          },
          "patientAvatar": {
            "type": "string",
            "description": "Patient Display Avatar"
          },
          "providerId": {
            "type": "string",
            "description": "Provider ID"
          },
          "providerName": {
            "type": "string",
            "description": "Provider Name"
          },
          "providerAvatar": {
            "type": "string",
            "description": "Provider Avatar"
          },
          "serviceId": {
            "type": "string",
            "description": "Service Category/ID"
          },
          "service": {
            "type": "string",
            "description": "Service Display Name"
          },
          "date": {
            "type": "string",
            "description": "Booking Date (YYYY-MM-DD)"
          },
          "time": {
            "type": "string",
            "description": "Booking Time (HH:MM)"
          },
          "location": {
            "type": "string",
            "description": "Visit Location Address"
          },
          "amount": {
            "type": "number",
            "description": "Total Payment Amount"
          },
          "status": {
            "type": "string",
            "description": "Initial Status override"
          }
        },
        "required": [
          "patientId",
          "serviceId",
          "date",
          "time",
          "location"
        ]
      },
      "UpdateStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Target lifecycle status"
          },
          "visitNotes": {
            "type": "string",
            "description": "Visit summary/completion notes"
          },
          "disputeReason": {
            "type": "string",
            "description": "Dispute reason"
          }
        },
        "required": [
          "status"
        ]
      },
      "CancelAppointmentDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "Cancellation reason description"
          }
        },
        "required": [
          "reason"
        ]
      },
      "RescheduleDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "New appointment date (YYYY-MM-DD)"
          },
          "time": {
            "type": "string",
            "description": "New appointment time (HH:MM)"
          }
        },
        "required": [
          "date",
          "time"
        ]
      },
      "OverrideDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
